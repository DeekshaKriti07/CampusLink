# Generate a DIFFERENT value for each secret with: openssl rand -hex 32
# Use hex values here so DATABASE_URL does not require URL escaping.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
CORS_ORIGINS=https://your-domain.example
# Exactly 1 only if your HTTPS reverse proxy is the only hop reaching the app.
TRUST_PROXY_HOPS=0
OLLAMA_MODEL=llama3.2
