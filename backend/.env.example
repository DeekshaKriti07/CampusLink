NODE_ENV=development
PORT=5001
# Neon pooled URL for runtime; retain sslmode=require. Values below are examples.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&connection_limit=3&pool_timeout=30&connect_timeout=15
# Neon direct/unpooled URL for migrations. Never point this migration at MySQL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&connect_timeout=15
JWT_ACCESS_SECRET=
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=60000
# Optional local AI instead of Groq: set AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
